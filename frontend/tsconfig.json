{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,

    "noEmit": true,
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext",
    ],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@services/*": ["./bindings/paradox-modding-tools/services/*"],
      "@components": ["./src/lib/components"],
      "@components/wrappers/*": ["./src/lib/components/wrappers/*"],
      "@pages/*": ["./src/lib/pages/*"],
      "@stores/*": ["./src/lib/stores/*"],
      "@assets/*": ["./src/assets/*"],
      "@utils/*": ["./src/lib/utils/*"]
    }
  },
  "include": ["src", "bindings"]
}
