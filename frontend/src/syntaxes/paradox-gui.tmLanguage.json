{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Paradox GUI",
  "scopeName": "source.paradox-gui",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#gui-keyword" },
    { "include": "#number" },
    { "include": "#constant" },
    { "include": "#operator" },
    { "include": "#braces" },
    { "include": "#ident" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.paradox-gui",
      "begin": "#",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.paradox-gui",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "support.function.databinding.paradox-gui", "match": "\\[[^\\]]*\\]" }
      ]
    },
    "gui-keyword": {
      "name": "keyword.control.paradox-gui",
      "match": "\\b(types|type|template|widget|button|hbox|vbox|container|scrollarea|flowcontainer|fixedgridbox|overlappingcontainer|background|icon|datamodel|datacontext|visible|size|position|margin|using|blockoverride|onmousehierarchyenter|text)\\b"
    },
    "number": {
      "name": "constant.numeric.paradox-gui",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "constant": {
      "name": "constant.language.paradox-gui",
      "match": "\\b(yes|no)\\b"
    },
    "operator": {
      "name": "keyword.operator.paradox-gui",
      "match": "=|<|>|!="
    },
    "braces": {
      "name": "punctuation.section.paradox-gui",
      "match": "[{}]"
    },
    "ident": {
      "name": "variable.other.paradox-gui",
      "match": "[A-Za-z_][\\w.]*"
    }
  }
}
